// File: backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ActivityIntensity {
  WALKING
  MODERATE
  VIGOROUS
  MUSCLE_STRENGTHENING
  ACUTE_AEROBIC_RELIEF
}

enum DataSource {
  WEB_SENSOR_API
  POSE_CAMERA_AI
  MANUAL_LOG
}

enum StressSeverity {
  LOW
  MODERATE
  HIGH
  SEVERE
}

model User {
  id                  String   @id @default(uuid())
  name                String   @db.VarChar(100)
  nim                 String   @unique @db.VarChar(30)
  email               String   @unique @db.VarChar(120)
  passwordHash        String   @db.VarChar(255)
  department          String   @default("Teknik Informatika") @db.VarChar(100)
  weeklyMetsTarget    Int      @default(1500)
  postureBaselineJson Json?
  pushSubscription    Json?
  currentStreakDays   Int      @default(0)
  xpPoints            Int      @default(0)
  targetRecoveryScore Float?   @default(40.0)
  createdAt           DateTime @default(now())

  sedentarySessions   SedentarySession[]
  physicalActivities  PhysicalActivity[]
  dailyWellbeingLogs  DailyWellbeingLog[]
  clinicalAssessments ClinicalAssessment[]
  aiCoachingInsights  AiCoachingInsight[]
  academicSchedules   AcademicSchedule[]
  dailyFussionLogs    DailyFussionLog[]
  activeBreakSessions ActiveBreakSession[]
}

model SedentarySession {
  id                 String     @id @default(uuid())
  userId             String
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  slouchCount        Int        @default(0)
  tooCloseCount      Int        @default(0)
  avgNeckRatio       Float      @default(1.0)
  breakCompleted     Boolean    @default(false)
  breakDurationMins  Int        @default(0)
  verificationSource DataSource @default(POSE_CAMERA_AI)
  createdAt          DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime])
}

model PhysicalActivity {
  id              String            @id @default(uuid())
  userId          String
  activityDate    DateTime          @db.Date
  intensityType   ActivityIntensity
  durationMinutes Int
  stepsCount      Int               @default(0)
  avgCadenceSpm   Int               @default(0)
  calculatedMets  Float
  source          DataSource        @default(WEB_SENSOR_API)
  notes           String?           @db.VarChar(255)
  createdAt       DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityDate])
}

model DailyWellbeingLog {
  id                     String         @id @default(uuid())
  userId                 String
  logDate                DateTime       @db.Date
  sleepHours             Float
  sleepQualityScore      Int
  nonAcademicScreenHours Float          @default(0.0)
  pss4RawAnswersJson     Json
  pss4TotalScore         Int
  totalSedentaryHours    Float          @default(0.0)
  totalMvpaMinutes       Int            @default(0)
  mvpaPerSedentaryRatio  Float          @default(0.0)
  triadPillarsMet        Int            @default(0)
  stressRiskLevel        StressSeverity @default(LOW)
  createdAt              DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logDate])
}

model ClinicalAssessment {
  id             String         @id @default(uuid())
  userId         String
  assessmentDate DateTime       @default(now())
  instrumentType String         @default("PSS_10")
  rawAnswersJson Json
  totalScore     Int
  severityLevel  StressSeverity
  notes          String?        @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentDate])
}

model AiCoachingInsight {
  id                     String   @id @default(uuid())
  userId                 String
  createdAt              DateTime @default(now())
  dominantMediator       String   @db.VarChar(80)
  diagnosisSummary       String   @db.Text
  isotemporalActionPlan  String   @db.Text
  recommendedMetsToday   Int
  scientificCitationNote String   @db.VarChar(255)
  isCompleted            Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ==============================================================================
// PRD Versi 4.0 — Fusi Parameter & Strava Akademik Models
// ==============================================================================

model AcademicSchedule {
  id          String   @id @default(uuid())
  userId      String
  dayOfWeek   Int      // 1 = Senin, ... 7 = Minggu
  subjectName String   @db.VarChar(120)
  creditHours Float    @default(2.0)
  isPracticum Boolean   @default(false)
  isExamWeek  Boolean   @default(false)
  examDate    DateTime? @db.Date // Tanggal ujian aktual untuk Dynamic Pre-Exam Escalation Curve
  classType   String    @default("teori") @db.VarChar(20)
  startTime   String?  @db.VarChar(10)
  endTime     String?  @db.VarChar(10)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model DailyFussionLog {
  id                  String   @id @default(uuid())
  userId              String
  logDate             DateTime @db.Date
  totalScreenTimeMins Int      @default(0)
  sleepHours          Float    @default(7.0)
  academicLoadScore   Float    @default(0.0)
  screenFatigueScore  Float    @default(0.0)
  recoveryScore       Float    @default(0.0)
  verifiedBreakCount  Int      @default(0)
  burnoutIndex        Float    @default(0.0)
  status              String   @default("LOW") @db.VarChar(20)
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logDate])
}

model ActiveBreakSession {
  id           String   @id @default(uuid())
  userId       String
  startTime    DateTime @default(now())
  durationMins Float    @default(2.0)
  poseVerified Boolean  @default(false)
  poseType     String   @default("OVERHEAD_STRETCH") @db.VarChar(50)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime])
}


