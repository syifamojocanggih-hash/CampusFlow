{
  "name": "@campusflow/backend",
  "private": true,
  "version": "1.0.0",
  "description": "CampusFlow Backend API, Clinical Scoring Engine, Prisma MySQL, & Ollama Local AI Coach",
  "type": "module",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "start:prod": "npx prisma migrate deploy && node dist/backend/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/services/clinicalScoring.test.ts src/services/ollamaCoach.test.ts src/middleware/rateLimit.test.ts src/app.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
