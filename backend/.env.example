# ==============================================================================
# CampusFlow Backend Environment Template (salin menjadi backend/.env)
# ==============================================================================
# JANGAN PERNAH commit file backend/.env yang berisi secret ke Git!

# Port server Express API
PORT=4000

# Koneksi MySQL 8.x (lokal, Docker, atau TiDB Cloud)
# Contoh lokal: mysql://root:password@localhost:3306/campusflow
DATABASE_URL="mysql://root:password@localhost:3306/campusflow"

# Secret JWT untuk autentikasi mahasiswa (ganti dengan string acak minimal 32 karakter)
JWT_SECRET="ganti_dengan_secret_acak_minimal_32_karakter"

# Google Gemini API Key (server-side only, dari https://aistudio.google.com/apikey)
# Jika kosong saat dev lokal, AI Coach dapat menggunakan fallback deterministik.
GEMINI_API_KEY=""

# VAPID Keys untuk Web Push Notification (generate dengan: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@campusflow.id"

# Origin frontend yang diizinkan oleh CORS (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN="http://localhost:5173,https://localhost:5173"

