# ==============================================================================
# CampusFlow Frontend PWA Environment Template (salin menjadi frontend/.env.local)
# ==============================================================================
# PERINGATAN KEAMANAN:
# Semua variabel berawalan VITE_ terekspos ke browser client.
# DILARANG menaruh DATABASE_URL, JWT_SECRET, OLLAMA_BASE_URL internal, atau VAPID_PRIVATE_KEY di sini!

# Base URL REST API Backend
VITE_API_BASE_URL="http://localhost:4000/api/v1"

# Mode mock data offline (true = pakai fixture docs/frontend/MOCK_DATA.md tanpa backend,
# false = panggil REST API backend asli)
VITE_USE_MOCK="true"

# Public Key VAPID (harus sama dengan VAPID_PUBLIC_KEY di backend/.env; BUKAN private key)
VITE_VAPID_PUBLIC_KEY=""

# Mode Demo Juri (true = percepat batas waktu duduk 50 menit menjadi 15 detik untuk presentasi)
VITE_DEMO_MODE="false"

